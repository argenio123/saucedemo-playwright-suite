# Copy this file to .env and fill in the real value.
# .env is git-ignored - never commit the actual key.

# Testomat.io project API key, from Project Settings -> Import tests.
TESTOMATIO=tstmt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Names the run in Testomat.io instead of an auto-generated title.
# TESTOMATIO_TITLE=SauceDemo regression

# Optional. Separates results by environment in the Testomat.io UI.
# TESTOMATIO_ENV=QA
